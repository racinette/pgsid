{
  "name": "pgsid",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "bin": {
    "pgsid": "dist/bin.js",
    "pgsid-language-server": "dist/language-server-bin.js"
  },
  "scripts": {
    "dev": "tsx src/bin.ts",
    "language-server": "tsx src/language-server-bin.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "builtin-inventory:generate": "node --import tsx scripts/generate-builtin-inventory.ts",
    "builtin-inventory:check": "node --import tsx scripts/generate-builtin-inventory.ts --check",
    "builtin-groups:explore": "node --import tsx scripts/explore-builtin-groups.ts",
    "sql-semantics:coverage": "node --import tsx scripts/report-sql-semantics-coverage.ts",
    "sql-semantics-goldens:update": "UPDATE_SQL_SEMANTICS_GOLDENS=1 vitest run tests/sql-semantics/operations.test.ts",
    "lint": "eslint . && pnpm espalier:check",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path tests/unit/query/.prettierignore --ignore-path tests/unit/query/sqlc-corpus/cases/.prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path tests/unit/query/.prettierignore --ignore-path tests/unit/query/sqlc-corpus/cases/.prettierignore",
    "go-ast:build": "docker run --rm -v $PWD/src/codegen/go:/src -w /src/wasm tinygo/tinygo:0.42.0 tinygo build -target wasm-unknown -buildmode=c-shared -no-debug -o /src/assets/go-ast.wasm .",
    "codegen-goldens:update": "UPDATE_CODEGEN_GOLDENS=1 vitest run tests/unit/codegen-goldens.test.ts",
    "espalier:lint": "espalier lint --config tests/unit/query/espalier.config.yaml",
    "espalier:build": "espalier build --config tests/unit/query/espalier.config.yaml",
    "espalier:check": "pnpm espalier:lint && espalier build --check --config tests/unit/query/espalier.config.yaml",
    "test": "vitest run",
    "test:watch": "vitest",
    "numeric-observations:generate": "node --import tsx scripts/generate-numeric-observations.ts",
    "numeric-observations:check": "node --import tsx scripts/generate-numeric-observations.ts --check"
  },
  "dependencies": {
    "@electric-sql/pglite": "file:./vendor/electric-sql-pglite-0.5.8.tgz",
    "@electric-sql/pglite-plpgsql-check": "file:./vendor/electric-sql-pglite-plpgsql-check-0.0.1.tgz",
    "chokidar": "^5.0.0",
    "fast-glob": "^3.3.3",
    "libpg-query": "18.0.1",
    "libpg-query-scanner": "npm:libpg-query@18.1.4",
    "pgsql-deparser": "18.1.1",
    "picomatch": "^4.0.5",
    "typescript": "^5.7.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chokidar": "^2.1.7",
    "@types/node": "^22.10.0",
    "@types/picomatch": "^4.0.3",
    "eslint": "^9.20.0",
    "espalier": "github:racinette/espalier#a0171515b4e6dffaa286003b7e512e9632ffb964",
    "prettier": "^3.4.0",
    "tsup": "^8.4.0",
    "tsx": "^4.20.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
